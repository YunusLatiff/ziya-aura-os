# Aura OS v0.8.6 - Dual-Port + Monthly Lead Quotas
AURA_PORT=4310
CRM_PORT=4311

# Public research providers
TAVILY_API_KEY=
GEOAPIFY_API_KEY=

# Hard monthly lead quotas (approved unique leads only)
LEADS_MONTHLY_APPROVED_CAP=180
VISION_MONTHLY_APPROVED_CAP=60
PETER_MONTHLY_APPROVED_CAP=60
MJ_MONTHLY_APPROVED_CAP=60
LEAD_QUOTA_TIMEZONE=Africa/Johannesburg

# Tavily hard budget protection. Basic-search usage is blocked at 900 credits.
TAVILY_MONTHLY_CREDIT_CAP=900
TAVILY_USAGE_STOP_PERCENT=90
TAVILY_CREDIT_RESERVE=25

RESEARCH_REGIONS=Johannesburg Gauteng South Africa|Pretoria Gauteng South Africa|Midrand Gauteng South Africa|Ekurhuleni Gauteng South Africa
RESEARCH_TICK_SECONDS=30

# Daily research cadence. Each researcher may open at most 3 lead batches per Johannesburg day.
# Batches remain 10 approved leads by default, but the 60-approved-leads/month hard cap still wins.
RESEARCH_DAILY_BATCHES_PER_AGENT=3
RESEARCH_DAILY_BATCH_TIMEZONE=Africa/Johannesburg

# Production supervisor
PRODUCTION_WATCHDOG_ENABLED=true
PRODUCTION_TONY_AUTOSTART=true
PRODUCTION_WATCHDOG_INTERVAL_SECONDS=30
PRODUCTION_BACKUP_INTERVAL_HOURS=6
PRODUCTION_BACKUP_RETENTION=30
PRODUCTION_AUTO_RESTORE_CORRUPT_DB=true
PRODUCTION_TONY_ROOT=
OUTBOUND_INTERRUPTED_MINUTES=10
